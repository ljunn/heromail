PORT=8080
HEROMAIL_BIND=0.0.0.0
COMPOSE_PROJECT_NAME=heromail
HEROMAIL_WORKER_TOKEN=请替换为随机邮件工作令牌
HEROMAIL_ADMIN_EMAIL=admin@heromail.local
HEROMAIL_ADMIN_PASSWORD=请替换为至少十位管理员密码
HEROMAIL_ENCRYPTION_KEY=请替换为六十四位十六进制主密钥
HEROMAIL_SEED_DEMO=false
HEROMAIL_PUBLIC_URL=http://localhost:8080
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common
MICROSOFT_REDIRECT_URI=
HEROMAIL_WEBHOOK_ALLOW_PRIVATE=false
# 后台邮箱连接验证、历史平台注册扫描和实时收码的并发上限
HEROMAIL_VERIFICATION_CONCURRENCY=32
HEROMAIL_HISTORY_SCAN_CONCURRENCY=4
HEROMAIL_MAIL_POLL_CONCURRENCY=32
POSTGRES_DB=heromail
POSTGRES_USER=heromail
POSTGRES_PASSWORD=请替换为本地开发密码
